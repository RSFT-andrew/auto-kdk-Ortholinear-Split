#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/* レイヤー番号の定義 */

#define DEFAULT 0
#define SCROLL  1
#define LAYER2  2
#define LAYER3  3
#define NUMBER  4
#define SYMBOL  5
#define WIRELESS 6
#define LAYER7  7

/ {
    /* トラックボールの挙動を制御するリスナー */

    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball_split>;

        /* スクロールレイヤー(SCROLL)が有効な時だけ発動する処理 */

        scroll {
            layers = <SCROLL>;
            input-processors = <&zip_xy_to_scroll_mapper>;
        };
    };

    behaviors {
        mky_L: mouse_Layer_behavior {
            compatible = "zmk,behavior-hold-tap";
            label = "MOUSE_LAYER_BEHAVIOR";
            bindings = <&mo>, <&mkp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <41>;
            quick-tap-ms = <(-1)>;
            require-prior-idle-ms = <(-1)>;
            tapping-term-ms = <200>;
        };

        mky_H_T: mousekey_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MOUSEKEY_HOLD_TAP";
            bindings = <&mkp>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp W             &kp E                   &kp LEFT_PARENTHESIS  &kp I          &kp RIGHT_PARENTHESIS                                      &none          &kp F  &kp S  &kp Y                &kp H                  &kp P
&kp A             &kp U                   &kp X                 &kp C          &kp O                                                      &tog 3         &kp R  &kp K  &kp T                &kp D                  &kp N
&kp Q             &mt AMPERSAND QUESTION  &kp J                 &kp V          &lt 5 COMMA            &kp PERIOD                          &kp BACKSPACE  &kp Z  &kp G  &kp B                &kp L                  &kp M
&lt 7 LANGUAGE_2  &tog 1                  &kp LG(Z)             &kp LS(LG(Z))  &kp LEFT_SHIFT         &kp SPACE   &mkp MB1  &mky_L 4 MB2  &lt 6 ENTER                  &mt RIGHT_ALT MINUS  &mt RIGHT_CONTROL TAB  &mt RIGHT_COMMAND LANGUAGE_1
            >;
        };

        scroll_layer_L {
            bindings = <
&trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };

        Scroll_Layer_R {
            bindings = <
&trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };

        mouse_Layer_1 {
            bindings = <
&kp ESCAPE            &mt END HOME          &kp GLOBE      &kp C                   &kp LG(INTERNATIONAL_3)                              &trans  &mt RG(F3) F3    &mkp MB4      &mkp MB5       &mkp MB1        &mkp MB2
&kp LS(LG(NUMBER_2))  &kp LS(LG(NUMBER_1))  &kp LS(LG(X))  &kp LS(LC(TAB))         &kp LC(TAB)                                          &trans  &kp RS(RC(TAB))  &kp RC(TAB)   &mkp MB3       &msc SCRL_DOWN  &msc SCRL_UP
&kp LS(LG(V))         &kp LS(LG(NUMBER_4))  &kp LS(LG(F))  &mt LC(LEFT) LC(RIGHT)  &trans                   &trans                      &trans  &trans           &kp RC(LEFT)  &kp RC(RIGHT)  &msc SCRL_LEFT  &msc SCRL_RIGHT
&trans                &trans                &mkp MB4       &mkp MB5                &mkp MB3                 &mkp MB2  &mkp MB1  &trans  &trans                                 &trans         &trans          &trans
            >;
        };

        mouse_Layer_2 {
            bindings = <
&kp ESCAPE            &mt END HOME          &kp GLOBE      &kp C            &kp LG(INTERNATIONAL_3)                          &trans  &mt RG(F3) F3          &kp RS(LEFT)  &kp RS(UP)    &kp RS(RIGHT)  &kp RG(INTERNATIONAL_3)
&kp LS(LG(NUMBER_2))  &kp LS(LG(NUMBER_1))  &kp LS(LG(X))  &kp LS(LC(TAB))  &kp LC(TAB)                                      &trans  &kp RG(RIGHT_CONTROL)  &kp UP        &kp RS(DOWN)  &mkp MB3       &kp RG(LEFT)
&kp LS(LG(V))         &kp LS(LG(NUMBER_4))  &kp LS(LG(F))  &kp LC(LEFT)     &kp LC(RIGHT)            &trans                  &trans  &kp LEFT               &kp DOWN      &kp RIGHT     &kp PAGE_DOWN  &kp PAGE_UP
&trans                &trans                &mkp MB4       &mkp MB5         &trans                   &trans  &trans  &trans  &trans                                       &trans        &trans         &trans
            >;
        };

        number {
            bindings = <
&kp LS(NUMBER_1)  &kp LA(LS(NUMBER_2))  &kp LS(NUMBER_9)  &kp LS(NUMBER_5)  &kp LS(NUMBER_0)                          &trans      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp EQUAL     &kp INTERNATIONAL_3
&kp LS(NUMBER_3)  &kp LS(NUMBER_4)      &kp SLASH         &kp ASTERISK      &kp LS(NUMBER_6)                          &trans      &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp COLON     &kp TILDE
&kp LS(NUMBER_7)  &kp LS(NUMBER_8)      &kp PLUS          &kp MINUS         &trans            &trans                  &kp DELETE  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_0  &kp PERIOD
&trans            &trans                &trans            &kp LG(Y)         &trans            &trans  &trans  &trans  &trans                                  &trans        &trans        &trans
            >;
        };

        symbol {
            bindings = <
&kp ESCAPE         &kp LEFT_BRACE  &kp LEFT_BRACKET       &kp RIGHT_BRACE    &kp RIGHT_BRACKET                                    &trans      &kp HOME         &kp END       &kp RG(W)          &kp RS(RG(V))  &kp RS(RG(NUMBER_4))
&kp DOUBLE_QUOTES  &kp SEMICOLON   &kp BACKSLASH          &kp COLON          &kp CARET                                            &trans      &kp RS(RC(TAB))  &kp RC(TAB)   &kp RG(T)          &kp RG(L)      &kp RS(RG(F))
&kp SQT            &kp GRAVE       &kp EQUAL              &kp UNDERSCORE     &kp LESS_THAN      &kp GREATER_THAN                  &kp DELETE  &trans           &kp RG(LEFT)  &kp RG(RC(RIGHT))  &kp RS(RC(L))  &kp RG(M)
&trans             &trans          &kp LG(RIGHT_BRACKET)  &kp LG(BACKSLASH)  &trans             &trans            &trans  &trans  &trans                                     &trans             &trans         &trans
            >;
        };

        wireless {
            bindings = <
&bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1    &bt BT_SEL 0                                &trans  &kp D  &kp D  &kp D   &kp D   &kp D
&kp B         &kp B         &kp B         &kp A           &kp A                                       &trans  &kp D  &kp D  &kp D   &kp D   &kp D
&kp B         &kp C         &kp B         &kp A           &bt BT_CLR_ALL  &bt BT_CLR                  &trans  &kp C  &kp D  &kp D   &kp C   &kp B
&trans        &trans        &bootloader   &studio_unlock  &trans          &trans      &trans  &trans  &trans                &trans  &trans  &trans
            >;
        };
    };
};
